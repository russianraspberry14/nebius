# Auth. Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# Token Factory model IDs — confirmed via client.models.list() against a
# live account on 2026-10-29. The spec's own Super ID guess was missing a
# hyphen (super-120b, not super120b) - always verify against models.list()
# or the console rather than trusting a hardcoded string.
NANO_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
SUPER_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
ULTRA_MODEL_ID=nvidia/Nemotron-3-Ultra-550b-a55b

# External tool sources (Day 3). geocode and get_weather need no key
# (Open-Meteo). search_places falls back to OpenStreetMap Overpass if
# GOOGLE_PLACES_API_KEY is unset. search_events has no keyless fallback -
# set one of TICKETMASTER_API_KEY or SEATGEEK_CLIENT_ID.
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
